# Public browser credential. Restrict this token by allowed URL in Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Optional server-side token for higher NYC Open Data API limits.
SOCRATA_APP_TOKEN=

# Server-only MTA Bus Time credential used by the Vercel fallback API.
MTA_API_KEY=
MTA_FEED_URL=https://gtfsrt.prod.obanyc.com/vehiclePositions
